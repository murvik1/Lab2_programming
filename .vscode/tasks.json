{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ сборка проекта",
            "command": "D:\\msys2\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++20",
                "-g",
                "${workspaceFolder}\\ip_filter.cpp",
                "${workspaceFolder}\\ip_utils.cpp",
                "-o",
                "${workspaceFolder}\\ip_filter.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Сборка ip_filter.exe из двух .cpp файлов"
        }
    ]
}